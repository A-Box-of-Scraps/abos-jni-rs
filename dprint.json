{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 120,
  "markdown": {
    "textWrap": "always"
  },
  "includes": [
    "**/*.md",
    "**/*.toml"
  ],
  "excludes": [
    "**/target/**",
    "mise.toml"
  ],
  "plugins": [
    "npm:@dprint/markdown@0.28.2",
    "npm:@dprint/toml@0.9.0"
  ]
}
